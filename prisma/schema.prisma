// Wisdom Well schema.
//
// Phase 1 (Foundations): authentication, families, members, relationship graph.
// Phase 2 (Entries & the release engine): Entry, ReleaseRule, Release,
//   EventConfirmation.
//
// Stewardship succession (Phase 3) and voice-interview transcript workflow
// (Phase 4) reuse fields already present here (Family.inactivityThresholdDays,
// Entry.rawAudioUrl / transcriptRaw / transcriptStatus) but add no models yet.

generator client {
  provider      = "prisma-client-js"
  // native  — local dev (macOS / whatever the machine is)
  // debian-openssl-3.0.x — the Netlify / Vercel build image (Ubuntu 24.04)
  // rhel-openssl-3.0.x   — the serverless function runtime (Amazon Linux 2023)
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Unpooled connection for `prisma migrate` (Neon, Supabase, etc.). Falls back
  // to DATABASE_URL locally where there is no separate pooler.
  directUrl = env("DATABASE_DIRECT_URL")
}

// --- Authentication ---------------------------------------------------------

// An authenticated account. Linked to exactly one Member once onboarding is
// complete. `member` is nullable only for the brief window between first
// sign-in and creating/joining a family.
model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  createdAt            DateTime          @default(now())
  // Bumped (throttled) whenever the user makes an authenticated request. Drives
  // steward-inactivity detection in Phase 3.
  lastSeenAt           DateTime          @default(now())
  // scrypt hash ("scrypt$<salt>$<hash>"). Null until the person sets one — they
  // can still sign in with an emailed link.
  passwordHash         String?
  failedLoginCount     Int               @default(0)
  lockedUntil          DateTime?
  // When the one-time "Wisdom Well now uses a password" email went out.
  passwordPromptSentAt DateTime?
  reminderFrequency    ReminderFrequency @default(BIWEEKLY)
  lastRemindedAt       DateTime?
  // Opaque token for the one-click "stop these emails" link (set lazily).
  unsubscribeToken     String?           @unique
  member               Member?
  sessions             Session[]
}

enum ReminderFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  OFF
}

enum TokenPurpose {
  SIGN_IN // passwordless sign-in link
  INVITE // family invite; links the member, then set password + confirm details
  SET_PASSWORD // one-time "set your password" email to existing users
  RESET_PASSWORD // "forgot password"
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Single-use, short-lived token emailed to the user for passwordless sign-in.
// When issued as a family invite, memberId ties the token to the pre-created
// Member row it should link on redemption (spec: invite-by-email, Phase 5).
model MagicLinkToken {
  id        String       @id @default(cuid())
  token     String       @unique
  email     String
  memberId  String?
  member    Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose @default(SIGN_IN)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([email])
  @@index([memberId])
}

// --- Family & tree ---------------------------------------------------------

enum SuccessionPolicy {
  NAMED_ONLY // succession only ever goes to an explicitly named, accepted successor
  NAMED_THEN_ELDEST_DESCENDANT // fall back to the eldest living descendant of the founder with a login
}

model Family {
  id                      String           @id @default(cuid())
  name                    String
  // The Member responsible for this Family. Nullable only during creation
  // (the steward Member is created immediately after the Family row).
  stewardMemberId         String?          @unique
  stewardMember           Member?          @relation("FamilySteward", fields: [stewardMemberId], references: [id])
  // The person who created the family — the root for policy-based succession
  // walks (spec §10, "succession beyond the first hop"). Set once, at creation.
  founderMemberId         String?
  // The steward is considered inactive once their account has not been seen for
  // this many days. Then succession begins.
  inactivityThresholdDays Int              @default(365)
  // Once succession begins, the steward has this many days to sign in or
  // decline before the first successor is promoted.
  successionGraceDays     Int              @default(30)
  successionPolicy        SuccessionPolicy @default(NAMED_THEN_ELDEST_DESCENDANT)
  createdAt               DateTime         @default(now())

  members       Member[]          @relation("FamilyMembers")
  relationships Relationship[]
  entries       Entry[]
  successors    Successor[]
  transfers     StewardTransfer[]
  prompts       Prompt[]
  joinRequests  JoinRequest[]
  // Shareable secret for the "ask to join" link (set lazily; rotatable).
  joinCode      String?           @unique
}

enum MembershipStatus {
  ACTIVE
  // The person has left this family (estrangement, a split). They keep entries
  // already released to them — releases are irreversible (spec §4) — but drop
  // out of future ROLE / IMMEDIATE / ALL_FAMILY releases and the steward's
  // aggregate. An author can still target them explicitly with SPECIFIC_MEMBER.
  DEPARTED
}

// A person in the family tree. May or may not have a login: children, deceased
// ancestors, and not-yet-born descendants exist as records without a `user`.
model Member {
  id                 String           @id @default(cuid())
  familyId           String
  family             Family           @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: Cascade)
  givenName          String
  familyName         String
  // Required before any age-based release rule can evaluate against this person.
  dateOfBirth        DateTime?
  dateOfDeath        DateTime?
  userId             String?          @unique
  user               User?            @relation(fields: [userId], references: [id])
  status             MembershipStatus @default(ACTIVE)
  departedAt         DateTime?
  // Set once an invited person has reviewed their own name / birthday.
  detailsConfirmedAt DateTime?
  createdAt          DateTime         @default(now())

  stewardOf         Family?        @relation("FamilySteward")
  relationshipsFrom Relationship[] @relation("RelationshipFrom")
  relationshipsTo   Relationship[] @relation("RelationshipTo")

  entriesAuthored    Entry[]             @relation("EntryAuthor")
  rulesTargeting     ReleaseRule[]       @relation("RuleTargetMember")
  releasesReceived   Release[]           @relation("ReleaseRecipient")
  eventConfirmations EventConfirmation[] @relation("ConfirmationSubject")

  successorSlot Successor?        @relation("SuccessorMember")
  transfersFrom StewardTransfer[] @relation("TransferFrom")
  transfersTo   StewardTransfer[] @relation("TransferTo")
  invites       MagicLinkToken[]

  promptsAuthored Prompt[] @relation("PromptAuthor")
  promptsAskedOf  Prompt[] @relation("PromptAskedOf")

  @@index([familyId])
}

enum RelationshipType {
  PARENT_OF
  SPOUSE_OF
  SIBLING_OF
  // A descriptive, user-labelled link ("Godfather", "Like a sister"). Never
  // lineage, never a release-rule target, never used for succession.
  CUSTOM
}

// How a PARENT_OF edge came to be. Lineage traversal treats BIOLOGICAL and
// ADOPTIVE identically — an adopted grandchild IS a grandchild. STEP is
// included by default (the product's spirit is inclusive) but a ReleaseRule can
// opt out per-rule. GUARDIAN is a caregiving fact, not heritable lineage, and
// is never followed for descendant resolution.
enum ParentKind {
  BIOLOGICAL
  ADOPTIVE
  STEP
  GUARDIAN
}

// An asserted relationship between two members.
//
// PARENT_OF is the single source of truth for lineage. Grandparent,
// grandchild, aunt, cousin, descendant, etc. are NOT stored — they are derived
// by graph traversal in lib/relationships. SPOUSE_OF / SIBLING_OF are stored as
// user-asserted facts; traversal treats SPOUSE_OF as symmetric and does not use
// SIBLING_OF for lineage (siblings are inferred from shared parents).
model Relationship {
  id           String           @id @default(cuid())
  familyId     String
  family       Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   Member           @relation("RelationshipFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMemberId   String
  toMember     Member           @relation("RelationshipTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  type         RelationshipType
  // Set for PARENT_OF edges; null is read as BIOLOGICAL.
  parentKind   ParentKind?
  // Set for SPOUSE_OF edges when the marriage has ended (divorce). Lineage is
  // unaffected; a former spouse's relatives are no longer counted as in-laws.
  endedAt      DateTime?
  // The label for a CUSTOM relationship.
  customLabel  String?
  createdAt    DateTime         @default(now())

  @@unique([fromMemberId, toMemberId, type])
  @@index([familyId])
  @@index([fromMemberId])
  @@index([toMemberId])
}

// --- Entries & the release engine (Phase 2) -------------------------------

enum MediaType {
  TEXT
  AUDIO
  VIDEO
  IMAGE
}

enum TranscriptStatus {
  NONE
  PROCESSING
  DRAFT
  APPROVED
}

enum EntryStatus {
  DRAFT // author is still writing; invisible to everyone else, never evaluated
  SCHEDULED // published; rules are live and waiting for their triggers
  RELEASED // published; at least one recipient has received it
}

// A single piece of wisdom — the atomic unit of the product.
model Entry {
  id             String    @id @default(cuid())
  familyId       String
  family         Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorMemberId String
  author         Member    @relation("EntryAuthor", fields: [authorMemberId], references: [id])
  title          String
  body           String // rich text
  mediaType      MediaType @default(TEXT)
  mediaUrl       String?

  // Phase 4 (voice interview). The recording in the person's own voice is the
  // artifact; the transcript is a convenience layer over it and is never the
  // reason the audio is deleted (spec §6).
  rawAudioUrl      String?
  transcriptRaw    String?
  transcriptStatus TranscriptStatus @default(NONE)
  transcriptJobId  String? // AssemblyAI transcript id while transcriptStatus = PROCESSING
  interviewPrompt  String? // the question this wisdom answers, if any (any mode, not only voice)
  // Which prompt-library bucket / subtopic it answers (slugs from lib/prompts.ts).
  // Drives "areas to explore" and reminder picks.
  promptBucket     String?
  promptSubtopic   String?
  // Set when it answers a family-written prompt (custom / shared / asked).
  promptId         String?
  prompt           Prompt?          @relation(fields: [promptId], references: [id], onDelete: SetNull)
  // When the Claude reconciliation pass last ran. Null after a voice entry
  // reaches DRAFT via the mechanical fallback (e.g. the inline attempt hit a
  // serverless timeout); the daily job and a manual "polish" button pick these
  // up.
  reconciledAt     DateTime?

  status     EntryStatus @default(DRAFT)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  releasedAt DateTime?

  rules    ReleaseRule[]
  releases Release[]

  @@index([familyId])
  @@index([authorMemberId])
  @@index([status])
  @@index([promptId])
}

enum ReleaseTargetType {
  IMMEDIATE // everyone in the family, right now (only valid with trigger NONE)
  SPECIFIC_MEMBER // one named member
  ROLE // everyone matching a role relative to the author
}

enum ReleaseTargetRole {
  CHILD
  GRANDCHILD
  GREAT_GRANDCHILD
  ANY_DESCENDANT
  ALL_FAMILY
}

enum ReleaseTriggerType {
  NONE
  AGE
  DATE
  EVENT
}

enum ReleaseTriggerEvent {
  MARRIAGE
  GRADUATION
  BIRTH_OF_FIRST_CHILD
  DEATH_OF_AUTHOR
  CUSTOM
}

// The condition governing when an Entry becomes visible to its recipients.
// Attached to the Entry, not the Family. An Entry has one or more rules; if ANY
// rule matches for a given Member, that Member can see the Entry.
//
// The full matrix the product needs (spec §3):
//   IMMEDIATE     + NONE            everyone, now
//   SPECIFIC(x)   + AGE(n)          for x when they turn n
//   ROLE(GRANDCHILD) + AGE(n)       for any grandchild when they turn n
//   ROLE(ALL_FAMILY) + DATE(d)      for the whole family on date d
//   SPECIFIC(x)   + EVENT(MARRIAGE) for x when they marry
//   ROLE(ANY_DESCENDANT) + ...      for every descendant, forever
model ReleaseRule {
  id             String             @id @default(cuid())
  entryId        String
  entry          Entry              @relation(fields: [entryId], references: [id], onDelete: Cascade)
  targetType     ReleaseTargetType
  targetMemberId String?
  targetMember   Member?            @relation("RuleTargetMember", fields: [targetMemberId], references: [id])
  targetRole     ReleaseTargetRole?

  triggerType       ReleaseTriggerType   @default(NONE)
  triggerAge        Int?
  triggerDate       DateTime?
  triggerEvent      ReleaseTriggerEvent?
  triggerEventLabel String? // for CUSTOM

  // For descendant-targeted ROLE rules: whether STEP parent edges count when
  // resolving who is a "descendant". Default true — the product's spirit is
  // inclusive; the author can turn it off for a specific rule.
  includeStepDescendants Boolean @default(true)

  createdAt DateTime @default(now())

  releases      Release[]
  confirmations EventConfirmation[]

  @@index([entryId])
}

// A materialized record of a rule firing for a specific person. This is what
// the read layer (visibleEntriesFor) queries. Releases are irreversible: once
// a row exists the recipient keeps access. There is no unrelease.
model Release {
  id                String      @id @default(cuid())
  entryId           String
  entry             Entry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  ruleId            String
  rule              ReleaseRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  recipientMemberId String
  recipient         Member      @relation("ReleaseRecipient", fields: [recipientMemberId], references: [id], onDelete: Cascade)
  releasedAt        DateTime    @default(now())

  // An Entry releases to a given person exactly once, no matter how many rules
  // would match them.
  @@unique([entryId, recipientMemberId])
  @@index([recipientMemberId])
  @@index([entryId])
}

// A Steward's (or living author's) manual confirmation that an EVENT trigger
// has occurred for a specific person — "Michael's wedding happened". EVENT
// rules cannot be detected automatically and guessing would be worse than
// asking. DEATH_OF_AUTHOR is confirmed instead by setting the author's
// Member.dateOfDeath, so it needs no row here.
model EventConfirmation {
  id                  String      @id @default(cuid())
  ruleId              String
  rule                ReleaseRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  subjectMemberId     String
  subject             Member      @relation("ConfirmationSubject", fields: [subjectMemberId], references: [id], onDelete: Cascade)
  confirmedByMemberId String?
  confirmedAt         DateTime    @default(now())

  @@unique([ruleId, subjectMemberId])
  @@index([ruleId])
}

// --- Stewardship & succession (Phase 3) ---------------------------------

// An ordered line of succession for a family. Only the current steward manages
// it. `position` 1 is the first successor. A successor must have a login AND
// have accepted the role (`acceptedAt`) before the engine will promote them —
// you don't hand a family to someone who never agreed to it. When the accepted
// named list is exhausted, Family.successionPolicy decides whether to fall back
// to the eldest living descendant of the founder.
model Successor {
  id         String    @id @default(cuid())
  familyId   String
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memberId   String    @unique
  member     Member    @relation("SuccessorMember", fields: [memberId], references: [id], onDelete: Cascade)
  position   Int
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([familyId, position])
  @@index([familyId])
}

enum StewardTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StewardTransferCancelReason {
  STEWARD_RETURNED // the steward signed in again during the grace period
  STEWARD_DECLINED // the steward explicitly said "I'm still here"
  SUPERSEDED // conditions changed (e.g. no successors, steward changed)
}

// A pending or historical stewardship handover triggered by inactivity. At most
// one PENDING transfer per family. Completing it only changes
// Family.stewardMemberId and the successor list — it never grants the new
// steward visibility into sealed entries (spec §5 + Phase 3 "done when").
model StewardTransfer {
  id                String                       @id @default(cuid())
  familyId          String
  family            Family                       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromMemberId      String?
  fromMember        Member?                      @relation("TransferFrom", fields: [fromMemberId], references: [id])
  toMemberId        String
  toMember          Member                       @relation("TransferTo", fields: [toMemberId], references: [id])
  status            StewardTransferStatus        @default(PENDING)
  // The steward's lastSeenAt at the moment succession began — used to detect
  // whether they have since returned.
  stewardLastSeenAt DateTime
  initiatedAt       DateTime                     @default(now())
  graceEndsAt       DateTime
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      StewardTransferCancelReason?

  @@index([familyId, status])
}

// --- Family-written prompts ----------------------------------------------

enum PromptVisibility {
  PRIVATE // just for the author
  FAMILY // added to the family's shared prompts
}

// A question written by a family member. It can be private, shared with the
// whole family, and/or asked of one specific person (askedOfMemberId), who
// then sees it under "Questions for you".
model Prompt {
  id              String           @id @default(cuid())
  familyId        String
  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorMemberId  String
  author          Member           @relation("PromptAuthor", fields: [authorMemberId], references: [id], onDelete: Cascade)
  askedOfMemberId String?
  askedOf         Member?          @relation("PromptAskedOf", fields: [askedOfMemberId], references: [id], onDelete: SetNull)
  text            String
  visibility      PromptVisibility @default(PRIVATE)
  // Set when the asked person dismisses it without answering.
  dismissedAt     DateTime?
  createdAt       DateTime         @default(now())

  entries Entry[]

  @@index([familyId])
  @@index([askedOfMemberId])
}

// --- Join requests -----------------------------------------------------------

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// Someone who followed a family's join link and asked to be added. Only the
// steward sees these; approving places them in the tree and sends an invite.
model JoinRequest {
  id           String            @id @default(cuid())
  familyId     String
  family       Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  givenName    String
  familyName   String
  email        String
  relationNote String // "how you're related", free text
  status       JoinRequestStatus @default(PENDING)
  // The member created on approval.
  memberId     String?
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?

  @@index([familyId, status])
}
