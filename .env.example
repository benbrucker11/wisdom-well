# Postgres. DATABASE_URL is what the app uses (a pooled connection on Neon /
# Supabase); DATABASE_DIRECT_URL is the unpooled connection `prisma migrate`
# needs. Locally, set both to the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wisdom_well?schema=public"
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wisdom_well?schema=public"

# Public URL of the site, for links in emails the daily job sends (reminders,
# the one-time "set your password" email). Falls back to Netlify's URL /
# Vercel's production URL, then http://localhost:3000.
# APP_URL="https://wisdomwell.example.com"

# Email delivery for invites, sign-in links, password resets, reminders, and
# succession notices. Resend is
# preferred; SMTP_URL is the fallback. Without either, links are printed to the
# server console (and always are, outside production).
# RESEND_API_KEY="re_xxxxxxxxx"
# MAIL_FROM="Wisdom Well <onboarding@resend.dev>"   # sandbox: only delivers to the Resend account owner
# SMTP_URL="smtp://user:password@smtp.example.com:587"

# Protects the daily job at /api/cron/evaluate. Required in production.
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# CRON_SECRET="a-long-random-string"

# --- Media storage ---
# Local disk (default): where files are written.
# STORAGE_DIR="/var/lib/wisdom-well/storage"
#
# S3-compatible object storage (spec §8) — required on a serverless host, where
# the local disk is ephemeral. Cloudflare R2 is the recommended target (10 GB
# free, no egress fees). Setting S3_BUCKET switches lib/storage.ts to this path.
# S3_BUCKET="wisdom-well-media"
# S3_REGION="auto"                                   # "auto" for R2
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"   # omit for real AWS S3
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# With S3 set, the browser uploads straight to the bucket (signed PUT), so the
# bucket needs a CORS rule allowing PUT from the site — see docs/DEPLOY.md.

# --- Voice interview (spec §6) ---
# Both are proxied server-side and never sent to the browser. Without
# ASSEMBLYAI_API_KEY the interview page still records but does not transcribe.
# Without an Anthropic credential the transcript is cleaned up mechanically
# instead of by Claude — the author reviews it either way.
# The Anthropic key also powers "Ask me something different" in Add wisdom.
# ASSEMBLYAI_API_KEY="..."
# ANTHROPIC_API_KEY="sk-ant-..."
