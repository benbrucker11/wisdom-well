# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wisdom_well?schema=public"

# Optional: real email delivery for magic-link sign-in.
# Without SMTP configured, sign-in links are printed to the server console
# (fine for local development).
# SMTP_URL="smtp://user:password@smtp.example.com:587"
# MAIL_FROM="Wisdom Well <no-reply@example.com>"

# Optional: protects the daily evaluation job at /api/cron/evaluate.
# Required in production; if unset, the route is open in development only.
# CRON_SECRET="a-long-random-string"

# Optional: where local-disk media is written (default: ./storage).
# STORAGE_DIR="/var/lib/wisdom-well/storage"

# Optional: switch media storage to S3-compatible presigned uploads (spec §8).
# Setting S3_BUCKET makes the local driver refuse to run — the S3 driver is a
# marked seam in lib/storage.ts, not yet implemented in this prototype.
# S3_BUCKET="wisdom-well-media"

# Voice interview (spec §6). Both are proxied server-side and never sent to the
# browser. Without ASSEMBLYAI_API_KEY the interview page still records but does
# not transcribe. Without an Anthropic credential the transcript is cleaned up
# mechanically instead of by Claude — the author reviews it either way.
# ASSEMBLYAI_API_KEY="..."
# ANTHROPIC_API_KEY="sk-ant-..."
