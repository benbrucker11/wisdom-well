# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wisdom_well?schema=public"

# Optional: real email delivery for magic-link sign-in.
# Without SMTP configured, sign-in links are printed to the server console
# (fine for local development).
# SMTP_URL="smtp://user:password@smtp.example.com:587"
# MAIL_FROM="Wisdom Well <no-reply@example.com>"
